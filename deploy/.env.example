# Production environment for the single-droplet stack.
#
#   cp deploy/.env.example deploy/.env   &&   chmod 600 deploy/.env
#
# deploy/.env is gitignored and must stay that way: it holds live secrets.
# Every value below marked REQUIRED has no usable default — the app either refuses
# to start without it, or starts and behaves wrongly.

# ---------------------------------------------------------------- database ----
# Used by the postgres container AND composed into SPRING_DATASOURCE_URL. The
# backend never talks to any host but the postgres service on the compose network.
POSTGRES_DB=housing_platform
POSTGRES_USER=housing_platform            # REQUIRED
POSTGRES_PASSWORD=                        # REQUIRED - generate: openssl rand -base64 32

# ------------------------------------------------------------------- auth ----
# REQUIRED. The app signs its own JWTs with HS256; this is the signing key, not a
# placeholder. Minimum 32 characters, enforced at startup (InternalJwtDecoder).
# Anyone holding it can mint a valid token for any account.
#   generate: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=ethiobuildconnect
JWT_EXPIRATION=3600

# Leave EMPTY. Setting it switches the resource server to an external identity
# provider (Keycloak et al) and the self-issued tokens above stop being accepted.
OAUTH2_JWK_SET_URI=

# REQUIRED for "Sign in with Google" — from the Google Cloud console OAuth client.
GOOGLE_OAUTH_CLIENT_ID=

# ------------------------------------------------------------------ public ----
# Canonical origin. Also baked into the frontend bundle at build time.
PUBLIC_SITE_URL=https://ethiobuildconnect.et
PUBLIC_API_BASE_URL=https://ethiobuildconnect.et
FRONTEND_BASE_URL=https://ethiobuildconnect.et

# ------------------------------------------------------------------- mail ----
# REQUIRED for password reset. A Gmail account needs an App Password, not the
# account password. This address is also what outbound mail is sent from.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ethiobuildconnect@gmail.com
MAIL_PASSWORD=

# --------------------------------------------------------------- payments ----
# REQUIRED to take real money. The defaults compiled into application.yml are TEST
# keys that are committed to the repository — live keys must come from here.
CHAPA_BASE_URL=https://api.chapa.global/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Contract/invoice details printed on purchase agreements. REQUIRED.
PURCHASE_PROVIDER_NAME=Dream Teams Trading PLC
PURCHASE_PROVIDER_EMAIL=ethiobuildconnect@gmail.com
PURCHASE_PROVIDER_PHONE=
PURCHASE_PROVIDER_REGISTRATION_NUMBER=
PURCHASE_PROVIDER_ADDRESS=Addis Ababa, Ethiopia
# REQUIRED: deposits are quoted in USD and charged in ETB, so this rate is the
# conversion actually billed. A stale value overcharges or undercharges every buyer.
PURCHASE_DEPOSIT_ETB_PER_USD=

# ------------------------------------------------------- support chat (AI) ----
# Without a key the support chat is the only thing that breaks; everything else runs.
SUPPORT_CHAT_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------- WhatsApp ----
# Only needed if WhatsApp notifications are used. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_NUMBER=

# ------------------------------------------------------------------ data ----
# Host directory holding the database (postgres/) and uploaded media (uploads/).
# Plain directories, not Docker volumes: no docker command can delete them.
# Default /var/lib/ethiobuildconnect. Change only before the first start.
#DATA_DIR=/var/lib/ethiobuildconnect

# ------------------------------------------------------------------ misc ----
IOS_APP_URL=
SWAGGER_ENABLED=false
RATE_LIMIT_AUTH_ENABLED=true

# ------------------------------------------------------------ live video ----
# Opt-in. Uncomment COMPOSE_PROFILES to start the LiveKit services with the stack;
# needs an A record for live.ethiobuildconnect.et and ports 7881/tcp, 7882/udp,
# 3478/udp open. See deploy/README.md §11 before enabling on a 2 GB droplet.
#COMPOSE_PROFILES=live
# What the backend hands to browsers; Caddy proxies it to the livekit container.
LIVEKIT_URL=wss://live.ethiobuildconnect.et
# Any short name, and a secret:   openssl rand -hex 32
LIVEKIT_API_KEY=ebc
LIVEKIT_API_SECRET=
# MP4 replays of broadcasts (TrackComposite — safe on this host). Needs the egress
# service, i.e. the profile above.
LIVEKIT_RECORDING_ENABLED=true
